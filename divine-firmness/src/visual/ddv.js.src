<script>
(function(){
  var root = document.getElementById('ddv'); if(!root) return;
  var $ = function(i){ return document.getElementById(i); }, NS = 'http://www.w3.org/2000/svg';
  var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  /* the four regulations, in the colours of the sketches */
  var LV = {'SOFT':{n:1,name:'Soft',c0:'#3F5F58',c1:'#4D8076',c2:'#60C2B3',hl:'#8FF7E4',d:'63 kg/m³'},
            'MEDIUM':{n:2,name:'Medium',c0:'#304B4F',c1:'#1F757A',c2:'#0CA9CA',hl:'#6FE9FF',d:'75 kg/m³'},
            'FIRM':{n:3,name:'Firm',c0:'#2E5C4C',c1:'#1F777B',c2:'#0F6DCB',hl:'#8DFFB8',d:'83 kg/m³'},
            'EXTRA FIRM':{n:4,name:'Extra Firm',c0:'#2F415D',c1:'#2D4293',c2:'#620FCD',hl:'#E070FF',d:'83 kg/m³ + 2 coir'}};
  var ORDER = ['SOFT','MEDIUM','FIRM','EXTRA FIRM'];
  var NEUTRAL = {c0:'#2F3A3E',c1:'#3E5A60',c2:'#6E8F93',hl:'#7AF5F0'}, GRAPHITE = {c0:'#35393B',c1:'#4A5154',c2:'#6B7478',hl:'#B9C6C9'};
  var tips = root.querySelectorAll('.ddv-tip'), openLi = null, timer = null, last = null, gl = 1;
  root.classList.add('ddv-js');
  for(var t = 0; t < tips.length; t++) tips[t].hidden = true;

  /* the regulation ring: four positions, never weak or strong */
  function arc(a0, a1){
    var p = function(r, a){ a = (a - 90) * Math.PI / 180; return (60 + r * Math.cos(a)).toFixed(2) + ' ' + (60 + r * Math.sin(a)).toFixed(2); };
    return 'M' + p(56, a0) + ' A56 56 0 0 1 ' + p(56, a1) + ' L' + p(36, a1) + ' A36 36 0 0 0 ' + p(36, a0) + ' Z';
  }
  (function(){
    var h = '<defs>';
    ORDER.forEach(function(k, i){ var L = LV[k]; h += '<linearGradient id="ddv-d' + i + '" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="' + L.c2 + '"/><stop offset=".55" stop-color="' + L.c1 + '"/><stop offset="1" stop-color="' + L.hl + '"/></linearGradient>'; });
    h += '</defs>';
    ORDER.forEach(function(k, i){ h += '<path id="ddv-s' + i + '" d="' + arc(i * 90 + 3, i * 90 + 87) + '" fill="url(#ddv-d' + i + ')" fill-opacity=".06"/>'; });
    $('ddv-dn').innerHTML = h;
  })();
  function ring(on, cap, sub){
    ORDER.forEach(function(k, i){ var p = $('ddv-s' + i), a = on.indexOf(k) > -1; p.setAttribute('fill-opacity', a ? 1 : .06); p.setAttribute('class', a ? 'on' : ''); });
    $('ddv-dnc').innerHTML = '<b>' + cap + '</b><span>' + sub + '</span>';
  }

  /* points */
  function close(){
    if(!openLi) return;
    openLi.querySelector('.ddv-tip').hidden = true; openLi.querySelector('button').setAttribute('aria-expanded', 'false');
    openLi = null; root.removeAttribute('data-p');
  }
  function photo(){
    var im = $('ddv-photo'), u = im.getAttribute('data-src');
    if(im.src || !/^(https:|data:)/.test(u || '')) return;
    im.addEventListener('load', function(){ im.classList.add('ddv-ok'); });
    im.src = u;
  }
  function open(li){
    if(li === openLi){ close(); return; }
    close(); openLi = li;
    var i = li.getAttribute('data-i');
    li.querySelector('.ddv-tip').hidden = false; li.querySelector('button').setAttribute('aria-expanded', 'true');
    if(i === '8') photo();
    if(i === '5'){ var sp = $('ddv-spi'); if(!sp.getAttribute('href')) sp.setAttribute('href', sp.getAttribute('data-src')); }
    root.removeAttribute('data-p'); void root.offsetWidth; root.setAttribute('data-p', i);
  }
  root.querySelectorAll('.ddv-hs').forEach(function(li){
    var b = li.querySelector('button');
    b.addEventListener('click', function(){ open(li); });
    if(li.getAttribute('data-i') === '8'){ b.addEventListener('pointerenter', photo); b.addEventListener('focus', photo); }
  });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && openLi){ var b = openLi.querySelector('button'); close(); b.focus(); } });
  document.addEventListener('pointerdown', function(e){ if(openLi && !openLi.contains(e.target)) close(); });
  /* the loops run only while the scene is on screen */
  if('IntersectionObserver' in window) new IntersectionObserver(function(en){ root.classList.toggle('ddv-vis', en[0].isIntersecting); }).observe(root);
  else root.classList.add('ddv-vis');

  /* helpers */
  function imp(kg){ var tl = kg / 0.45359237, st = Math.floor(tl / 14), lb = Math.round(tl - st * 14); if(lb === 14){ st++; lb = 0; } return st + ' st ' + lb + ' lb'; }
  function ftin(cm){ var ti = cm / 2.54, ft = Math.floor(ti / 12), i = Math.round(ti - ft * 12); if(i === 12){ ft++; i = 0; } return ft + '′' + i + '″'; }
  function ok(p){ return p && isFinite(p.w) && isFinite(p.h) && p.w >= 30 && p.w <= 250 && p.h >= 120 && p.h <= 230; }
  function nm(l){ return (LV[l] || {}).name || ''; }
  function grad(a, b){
    if(b) return 'linear-gradient(180deg,' + a.c0 + ' 0%,' + a.c1 + ' 34%,' + a.c2 + ' 57.6%,' + b.c1 + ' 57.7%,' + b.c2 + ' 100%)';
    return 'radial-gradient(60% 90% at 0 0,rgba(0,0,0,.24),transparent 70%),linear-gradient(176deg,' + a.c0 + ' 0%,' + a.c1 + ' 42%,' + a.c2 + ' 100%)';
  }
  function paint(bg, hl, c1, c2){
    var n = $('ddv-g' + (gl === 1 ? 2 : 1)), o = $('ddv-g' + gl);
    if(o.style.background === bg) return;
    n.style.background = bg; n.style.opacity = 1; o.style.opacity = 0; gl = gl === 1 ? 2 : 1;
    root.style.setProperty('--ddv-hl', hl); root.style.setProperty('--ddv-c1', c1); root.style.setProperty('--ddv-c2', c2);
  }
  function band(top, low){ root.style.setProperty('--ddv-t0', (low || top).c1); root.style.setProperty('--ddv-t2', (low || top).c2); root.style.setProperty('--ddv-u0', top.c1); root.style.setProperty('--ddv-u2', top.c2); }
  function fit(el, txt, max, size, min){
    el.textContent = txt; el.style.fontSize = size + 'px';
    try{ var w = el.getComputedTextLength(); if(w > max) el.style.fontSize = Math.max(min, size * max / w) + 'px'; }catch(e){}
  }
  function two2(el, a, b, x){
    el.style.fontSize = ''; el.textContent = '';
    [a, b].forEach(function(s, i){ var t = document.createElementNS(NS, 'tspan'); t.setAttribute('x', x); if(i) t.setAttribute('dy', 52); t.textContent = s; el.appendChild(t); });
  }
  function comp(f, title, upper, lower){
    var w = $('ddv-cmp');
    if(!f){ w.hidden = true; return; }
    $('ddv-ck').textContent = title;
    $('ddv-l1').style.background = 'linear-gradient(90deg,' + LV[f[1]].c1 + ',' + LV[f[1]].c2 + ')';
    $('ddv-l2').style.background = 'linear-gradient(90deg,' + LV[f[0]].c1 + ',' + LV[f[0]].c2 + ')';
    $('ddv-t1x').innerHTML = upper + ' <b>' + nm(f[1]) + '</b>'; $('ddv-t2x').innerHTML = lower + ' <b>' + nm(f[0]) + '</b>';
    w.hidden = false;
  }


  /* the one input: what the navigator sends, built on the engine's own answer */
  function apply(st){
    if(!st || !st.me) return;
    var touched = !!st.touched && ok(st.me), two = !!st.two && ok(st.pt), recs = st.recs || [], r0 = recs[0], r1 = recs[1];
    var f = (r0 && r0.firmness && r0.firmness.length) ? r0.firmness : [st.me.lv];
    var isTop = st.product === 'topper' && !two, isDual = function(r){ return r && r.firmness.length === 2 && /Dual Plush/.test(r.model); };
    var L = LV[st.me.lv] || LV.MEDIUM, P = two ? LV[st.pt.lv] : null;
    root.setAttribute('data-mode', touched ? 'personal' : 'explore');
    root.setAttribute('data-two', touched && two ? '1' : '0');
    root.setAttribute('data-top', !touched ? '0' : isTop ? 'only' : isDual(r0) ? '1' : '0');
    root.setAttribute('data-tl', isTop && f.length === 2 ? '2' : '1');

    /* colour of the mattress window */
    if(!touched) paint(grad(NEUTRAL), NEUTRAL.hl, NEUTRAL.c1, NEUTRAL.c2);
    else if(isTop){ paint(grad(GRAPHITE), LV[f[f.length - 1]].hl, GRAPHITE.c1, LV[f[0]].c2); band(LV[f[f.length - 1]], LV[f[0]]); }
    else if(two) paint(grad(L, P), L.hl, L.c1, P.c2);
    else if(isDual(r0)){ paint(grad(LV[f[0]]), LV[f[1]].hl, LV[f[0]].c1, LV[f[0]].c2); band(LV[f[1]]); }
    else paint(grad(L), L.hl, L.c1, L.c2);
    var dnEl = document.getElementById('dn'); if(dnEl) dnEl.style.setProperty('--dn-edge', touched ? (two ? P.c2 : L.c2) : '');

    /* inside the body: height left, weight right */
    var vh = $('ddv-vh'), vw = $('ddv-vw'), vf = $('ddv-vf'), vm = $('ddv-vm');
    if(!touched){ vh.style.fontSize = vw.style.fontSize = vf.style.fontSize = ''; vh.textContent = '— cm'; vw.textContent = '— kg'; vf.textContent = '—'; vm.textContent = '—'; vf.style.fontSize = vm.style.fontSize = ''; comp(null); }
    else {
      if(two){ two2(vh, 'You ' + st.me.h + ' cm', 'Partner ' + st.pt.h + ' cm', 705); two2(vw, 'You ' + st.me.w + ' kg', 'Partner ' + st.pt.w + ' kg', 1520); }
      else { fit(vh, st.me.h + ' cm / ' + ftin(st.me.h), 440, 62, 34); fit(vw, st.me.w + ' kg / ' + imp(st.me.w), 620, 62, 34); }
      /* inside the mattress: firmness left, model right */
      $('ddv-lf').innerHTML = isTop ? 'Your <tspan>Topper</tspan>:' : two ? 'Your <tspan>Firmness</tspan>: you / partner' : 'Your <tspan>Firmness</tspan>:';
      if(two){ two2(vf, L.name, P.name, 700); vf.style.fontSize = '58px'; vf.firstChild.setAttribute('dy', -28); vf.lastChild.setAttribute('dy', 64); }
      else fit(vf, isTop ? f.map(nm).reverse().join(' + ') : L.name, 760, 96, 44);
      var ms = recs.slice(0, 2), shared = two && ms.length === 1 && /Partners/.test(ms[0].model);
      if(!two && ms.length === 2 && isDual(ms[0]) && !isDual(ms[1])) ms = [ms[1], ms[0]];
      fit(vm, ms.length ? ms.map(function(r){ return r.model; }).join(two && !shared ? ' / ' : ' or ') : 'Ask us, we advise', 980, 78, 40);
      var dr = two ? null : isTop && f.length === 2 ? r0 : ms.filter(isDual)[0];
      if(dr) comp(dr.firmness, dr.model, isTop ? 'Upper layer' : 'Latex topper', isTop ? 'Lower layer' : 'Latex mattress'); else comp(null);
    }

    /* the ring */
    if(!touched) ring([], '4 levels', 'regulated by body');
    else if(two) ring([st.me.lv, st.pt.lv], '2 bodies', 'regulated apart');
    else if(isDual(r0) || (isTop && f.length === 2)) ring(f, nm(f[0]) + ' + ' + nm(f[1]), isTop ? 'topper layers' : 'base + topper');
    else ring([isTop ? f[0] : st.me.lv], isTop ? nm(f[0]) : L.name, isTop ? 'topper' : L.d);

    /* header text */
    $('ddv-chip').textContent = touched ? (two ? 'Two bodies · two regulations' : 'Your personalised regulation') : 'Explore';
    $('ddv-lead').innerHTML = !touched ? (st.waiting === 'partner' ? 'Now add your partner’s height and weight below. Each of you is regulated on your own body.' : 'Tap a glowing point. Enter your height and weight below, and the body and the mattress fill in for you.')
      : two ? 'Each of you is regulated on your own body, on one mattress. Tap a glowing point to see what each zone does.'
      : 'Your <b>' + st.me.w + ' kg</b> at <b>' + st.me.h + ' cm</b>, regulated by Dunlop. Tap a glowing point to see what each zone does for you.';

    /* the same answer as text, for every screen and for screen readers */
    $('ddv-rh').textContent = touched ? (two ? 'You ' + st.me.h + ' cm, partner ' + st.pt.h + ' cm' : st.me.h + ' cm / ' + ftin(st.me.h)) : 'Not entered yet';
    $('ddv-rw').textContent = touched ? (two ? 'You ' + st.me.w + ' kg, partner ' + st.pt.w + ' kg' : st.me.w + ' kg / ' + imp(st.me.w)) : 'Not entered yet';
    var ftx = touched && two ? 'You ' + L.name + ', partner ' + P.name : vf.textContent;
    $('ddv-rf').textContent = touched ? ftx : 'Set by your height and weight';
    $('ddv-rm').textContent = touched ? vm.textContent : 'Chosen by your answers below';
    var rr = '';
    if(touched){
      recs.slice(0, 2).forEach(function(r, i){
        var fm = r.firmness.map(nm), w = r.firmness.length === 2 ? (/Partners/.test(r.model) ? 'you ' + nm(st.me.lv) + ' · partner ' + nm(st.pt.lv) : /Support/.test(r.model) ? fm[0] + ' and ' + fm[1] + ' layers' : fm[0] + ' mattress · ' + fm[1] + ' topper') : fm[0];
        rr += '<span><em>' + (two ? (r.title || '') : (i ? 'Second choice' : 'First choice')) + '</em> <b>' + r.model + '</b> · ' + w + '</span> ';
      });
      if(two){ var ex = (st.notes || []).filter(function(n){ return !/regulated individually/.test(n[0]); })[0]; if(ex) rr += '<br><span><b>' + ex[0] + '.</b> ' + ex[1] + '</span>'; }
      if(!recs.length){ var n = (st.notes && st.notes[0]) || null; rr = n ? '<b>' + n[0] + '.</b> ' + n[1] : 'There is no approved combination for these measurements. Please contact us and we will advise.'; }
    }
    $('ddv-rr').innerHTML = rr; $('ddv-rr').hidden = !rr;
    $('ddv-gol').innerHTML = (touched ? 'See your mattress and change your answers' : 'Enter your height and weight') + ' <span aria-hidden="true">↓</span>';
    $('ddv-live').textContent = touched ? 'Regulation: ' + ftx + '. Model: ' + vm.textContent + '.' : '';
    last = st;
  }
  document.addEventListener('ddn:state', function(e){ var st = e.detail; clearTimeout(timer); timer = setTimeout(function(){ apply(st); }, last ? 140 : 0); });
  $('ddv-gol').addEventListener('click', function(e){
    var w = $('dn-w'); if(!w) return; e.preventDefault();
    (w.closest('.dn-card') || w).scrollIntoView({behavior: reduced ? 'auto' : 'smooth', block:'center'});
    setTimeout(function(){ try{ w.focus({preventScroll:true}); }catch(x){} }, reduced ? 0 : 450);
  });
  apply(window.DDN_STATE || {me:{w:0,h:0,lv:'MEDIUM'},recs:[]});
  if(document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ if(last) apply(last); });
})();
</script>
